    "message": {
     "content": "{\"items\": [{\"id\": \"subject\", \"text\": \"\u041e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u043a\u0430\u0437\u0430 \u0432 \u0432\u044b\u043f\u043b\u0430\u0442\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f CLM-7765301, \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0447\u043b\u0435\u043d\u0430 \u27e6V4\u27e7\"}, {\"id\": \"p0\", \"text\": \"\u042f \u043e\u0431\u0436\u0430\u043b\u0443\u044e \u043e\u0442\u043a\u0430\u0437 \u0432 \u0432\u044b\u043f\u043b\u0430\u0442\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f CLM-7765301 \u0434\u043b\u044f \u27e6V3\u27e7 (\u041a\u043e\u043c\u043d\u0430\u0442\u0430 \u0438 \u043f\u0438\u0442\u0430\u043d\u0438\u0435, 14 \u0438\u044e\u043b\u044f 2026 \u0433.). \u0412\u0430\u0448\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432 \u043f\u043e \u0434\u0430\u0442\u0435 15 \u043e\u043a\u0442\u044f\u0431\u0440\u044f 2026 \u0433. \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0432 \u043d\u0435\u043c \u0441 \u043a\u043e\u0434\u043e\u043c \u043f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u044f P31: \u00ab\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u0443\u0441\u043b\u0443\u0433\u0438.\u00bb\"}, {\"id\": \"p1\", \"text\": \"\u042d\u0442\u043e \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u043c\u043e\u044e \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044e \u043f\u0440\u0438 \u0440\u043e\u0434\u0430\u0445. \u0412 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435 \u043c\u043e\u0435\u0433\u043e \u043f\u043b\u0430\u043d\u0430 (\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 2) \u0441\u043a\u0430\u0437\u0430\u043d\u043e: \u00ab\u041c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430\u044f \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u0430\u044f \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u0440\u043e\u0434\u0430\u0445 \u0438 \u0440\u043e\u0434\u0430\u0445 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f.\u00bb\"}, {\"id\": \"p2\", \"text\": \"\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043c\u043e\u0439 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u043c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f. \u0412 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435 \u043c\u043e\u0435\u0433\u043e \u043f\u043b\u0430\u043d\u0430 (\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 2) \u0441\u043a\u0430\u0437\u0430\u043d\u043e: \u00ab\u041f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435 \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u043e\u0439 \u0433\u043e\u0441\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0440\u0438 \u0440\u043e\u0434\u0430\u0445 \u0434\u043e 48 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u0441\u043b\u0435 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0440\u043e\u0434\u043e\u0432 \u0438\u043b\u0438 96 \u0447\u0430\u0441\u043e\u0432 \u043f\u043e\u0441\u043b\u0435 \u0441\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u0441\u0435\u0447\u0435\u043d\u0438\u044f.\u00bb\"}, {\"id\": \"p3\", \"text\": \"\u0415\u0441\u043b\u0438 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e \u0432\u043e\u0432\u0440\u0435\u043c\u044f, \u043f\u043b\u0430\u043d \u043d\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0432 \u0432\u044b\u043f\u043b\u0430\u0442\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u044d\u0442\u043e\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u0435. \u0412 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0435 \u043c\u043e\u0435\u0433\u043e \u043f\u043b\u0430\u043d\u0430 (\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 2) \u0441\u043a\u0430\u0437\u0430\u043d\u043e: \u00ab\u0412 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u044d\u043a\u0441\u0442\u0440\u0435\u043d\u043d\u043e\u0439 \u043f\u043e\u043c\u043e\u0449\u0438 \u0438\u043b\u0438 \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e, \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u043c\u044b\u0435 \u0443\u0441\u043b\u0443\u0433\u0438 \u043d\u0435 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u044e\u0442 solely \u0438\u0437-\u0437\u0430 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f.\u00bb\"}, {\"id\": \"p4\", \"text\": \"\u0412\u0430\u0448\u0435 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u0430\u0432 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 $6,840.00, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u044c \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044e. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0435\u0433\u043e \u043a\u0430\u043a \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u0435\u043c\u0443\u044e \u0443\u0441\u043b\u0443\u0433\u0443 \u043f\u043e \u043c\u043e\u0435\u043c\u0443 \u043f\u043b\u0430\u043d\u0443.\"}, {\"id\": \"p5\", \"text\": \"\u042f \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e \u044d\u0442\u043e \u043e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043e 13 \u0430\u043f\u0440\u0435\u043b\u044f 2027 \u0433., \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043b\u0430\u043d \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u0441\u043b\u0435 \u043e\u0442\u043a\u0430\u0437\u0430. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0442\u0430\u043a\u0436\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043c\u043d\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u043a\u043e\u043f\u0438\u0438 \u0432\u0441\u0435\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0438 \u0434\u0440\u0443\u0433\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438, \u043e\u0442\u043d\u043e\u0441\u044f\u0449\u0435\u0439\u0441\u044f \u043a \u043c\u043e\u0435\u043c\u0443 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044e.\"}, {\"id\": \"p6\", \"text\": \"\u0424\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0434\u043b\u044f employer health plans \u0434\u0430\u044e\u0442 \u043c\u0438\u043d\u0438\u043c\u0443\u043c 180 \u0434\u043d\u0435\u0439 \u043d\u0430 \u043e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442\u043a\u0430\u0437\u0430 \u0432 \u0432\u044b\u043f\u043b\u0430\u0442\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f (29 CFR 2560.503-1(h)(3)(i)).\"}, {\"id\": \"p7\", \"text\": \"\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0441\u0432\u043e\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043f\u0438\u0441\u044c\u043c\u0435\u043d\u043d\u043e \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443 \u043d\u0438\u0436\u0435. \u0421\u043f\u0430\u0441\u0438\u0431\u043e.\"}]}",
