# Set to 1 to call the live API. Anything else replays recorded responses.
BILLRADAR_LIVE=0
# Nebius Token Factory key (tokenfactory.nebius.com -> API keys). Never commit the real value.
NEBIUS_API_KEY=
# Hard stop for live Token Factory spend, in USD, counted from token usage (runs/nebius-spend.jsonl).
NEBIUS_SPEND_CAP_USD=5
# Optional: other Nemotron ids from tokenfactory.nebius.com/api/public/models_info
# NEMOTRON_READER_MODEL=nvidia/Nemotron-3.5-Super-VL
# NEMOTRON_CHECKER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Set to 1 for the second read of each case (Nemotron 3 Ultra); the example was recorded with it on.
# BILLRADAR_SECOND_READ=1
